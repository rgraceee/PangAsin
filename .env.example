# WHAT: Template lang ito; kopyahin sa .env at palitan ang placeholder values.
# WHY: Hindi dapat ma-commit ang tunay na credentials o app password.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=replace-with-a-long-random-string
FLASK_ENV=development

# Gmail SMTP (port 587 + TLS). Use a Google App Password, not the account password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-project-account@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password
MAIL_DEFAULT_SENDER=PangAsin <your-project-account@gmail.com>

# Base URL used in reset links (no trailing slash). The Flask app serves the
# built React bundle on port 5000; use http://localhost:5173 only with Vite dev.
FRONTEND_URL=http://localhost:5000
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_RATE_WINDOW=3600
