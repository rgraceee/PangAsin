# WHAT: Template lang ito; kopyahin sa .env at palitan ang placeholder values.
# WHY: Hindi dapat ma-commit ang tunay na credentials o app password.
#      Bawat variable ay may default sa code kung hindi naka-set sa .env.

# ---------- Database ----------
# PostgreSQL via Supabase (recommended) or local SQLite.
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
# For local SQLite: sqlite:///./pangasin.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Optional: connection pool sizing. Lower these on serverless hosts (Vercel)
# so many short-lived instances do not exhaust the database connection limit.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# ---------- Generated report files ----------
# Optional: writable directory for generated PDF/DOCX report files.
# Vercel's filesystem is read-only except /tmp, so set REPORTS_DIR=/tmp/reports
# there. Leave unset locally to keep using app/static/reports.
# REPORTS_DIR=

# ---------- App security ----------
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
FLASK_ENV=production

# Base URL used in password reset links (no trailing slash).
# Production: https://pangasin.example.org
# Local: http://localhost:5000
FRONTEND_URL=http://localhost:5000

# ---------- SMTP (email for password reset, test email) ----------
# Use a Google App Password (Gmail) or SMTP credentials from your provider.
# NEVER commit the real MAIL_PASSWORD.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-project-account@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password-or-smtp-password
MAIL_DEFAULT_SENDER=PangAsin <your-project-account@gmail.com>

# ---------- Password & lockout policy ----------
# These match the system_settings defaults; override via .env only if you
# want a different starting value before any SuperAdmin changes them.
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_RATE_WINDOW=3600

# Admin write rate limit (per user, per window seconds)
ADMIN_WRITE_RATE_LIMIT=120
ADMIN_WRITE_RATE_WINDOW=60

# Login rate limit (per IP + email, per window seconds)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=60

# ---------- PostgreSQL backup ----------
# Path to the pg_dump executable used by /api/superadmin/export/backup.
# Leave unset to fall back to shutil.which("pg_dump") (PATH).
PG_DUMP_PATH=/usr/bin/pg_dump

# ---------- Feature flags ----------
RATE_LIMIT_ENABLED=1
